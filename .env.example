# Google dork delay — seconds between Google search queries
GOOGLE_DORK_DELAY=10

# Google Maps scroll delay range (seconds)
MAPS_SCROLL_DELAY_MIN=2
MAPS_SCROLL_DELAY_MAX=5

# httpx request timeout (seconds)
REQUEST_TIMEOUT=8

# SMTP socket timeout (seconds)
SMTP_TIMEOUT=6

# Max parallel SMTP verification connections
SMTP_CONCURRENCY=15

# Max parallel website crawl connections
CRAWLER_CONCURRENCY=10

# Max email permutations to try per contact
MAX_PERMUTATIONS=5

# Retry delay for rate-limited requests (seconds)
RETRY_DELAY=45

# Flask settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
